# ==============================================================================
# People Journey HR Portal - Environment Variables Template
# Copy this file to .env or .env.local and populate with your local values.
# NEVER commit real credentials, service account keys, or secrets to version control.
# ==============================================================================

# --- Frontend Application (Vite / Next.js) ---
PORT=3000
BASE_PATH=/
VITE_API_BASE_URL=http://localhost:5000/api

# --- Firebase Client SDK (Public Client-Side Configuration) ---
# Safe for frontend bundle exposure (protected by Firebase Security Rules & domain allowlists)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Backend Application (Express / Spring Boot REST API) ---
API_PORT=5000
NODE_ENV=development

# --- PostgreSQL Database ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/people_journey_db

# --- Firebase Admin SDK (Backend-Only - NEVER expose to frontend) ---
# Path to service account JSON or base64 encoded credential string
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
