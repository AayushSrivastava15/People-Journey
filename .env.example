# ==============================================================================
# People Journey HR Portal - Environment Variables Template
# Copy this file to .env or .env.local and populate with your local values.
# NEVER commit real credentials, service account keys, or database passwords.
# ==============================================================================

# --- Frontend Application (Vite) ---
PORT=3000
BASE_PATH=/
VITE_API_BASE_URL=http://localhost:5000/api

# --- Firebase Client SDK (Public Client Configuration) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=peoplejourney-4d586.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=peoplejourney-4d586
VITE_FIREBASE_STORAGE_BUCKET=peoplejourney-4d586.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=60369419714
VITE_FIREBASE_APP_ID=1:60369419714:web:dc18659188829f0daf6a5b

# --- Backend Application (Express REST API) ---
API_PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Supabase PostgreSQL Database (Project: imdbjeofboslwmflbtby, ap-south-1 Mumbai) ---
# Application connection (Transaction-mode pooler on port 6543):
DATABASE_URL=postgresql://postgres.imdbjeofboslwmflbtby:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migration connection (Session-mode pooler on port 5432):
DIRECT_URL=postgresql://postgres.imdbjeofboslwmflbtby:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# --- Firebase Admin SDK (Backend-Only - NEVER expose to frontend) ---
FIREBASE_PROJECT_ID=peoplejourney-4d586
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

