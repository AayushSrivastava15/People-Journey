    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
